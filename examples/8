# Test 5: Complex Algorithms
# Tests: Fibonacci, Factorial, GCD, Prime checking, and more

procedure Main is
  n, result, i : Integer;
  a, b, temp : Integer;
  num1, num2, gcd : Integer;
  isPrime : Boolean;
  divisor, count : Integer;
begin
  # === FACTORIAL CALCULATION ===
  Put_Line("== Factorial ==");
  Put_Line("Enter a number for factorial:");
  Get_Line(n);
  
  result := 1;
  i := 1;
  
  while i <= n loop
    result := result * i;
    i := i + 1;
  end loop;
  
  Put_Line("Factorial result:");
  Put_Line(result);
  
  # === FIBONACCI SEQUENCE ===
  Put_Line("== Fibonacci ==");
  Put_Line("Enter how many Fibonacci numbers:");
  Get_Line(n);
  
  a := 0;
  b := 1;
  i := 0;
  
  Put_Line("Fibonacci sequence:");
  while i < n loop
    Put_Line(a);
    temp := a + b;
    a := b;
    b := temp;
    i := i + 1;
  end loop;
  
  # === GREATEST COMMON DIVISOR (Euclidean Algorithm) ===
  Put_Line("== GCD ==");
  Put_Line("Enter first number:");
  Get_Line(num1);
  Put_Line("Enter second number:");
  Get_Line(num2);
  
  while num2 /= 0 loop
    temp := num2;
    num2 := num1 rem num2;
    num1 := temp;
  end loop;
  
  gcd := num1;
  Put_Line("GCD result:");
  Put_Line(gcd);
  
  # === PRIME NUMBER CHECKER ===
  Put_Line("== Prime Checker ==");
  Put_Line("Enter a number to check if prime:");
  Get_Line(n);
  
  count := 0;
  
  if n < 2 then
    count := 1;
  else
    divisor := 2;
    while divisor * divisor <= n loop
      if n rem divisor = 0 then
        count := count + 1;
      end if;
      divisor := divisor + 1;
    end loop;
  end if;
  
  if count = 0 then
    Put_Line("Number is prime");
  else
    Put_Line("Number is not prime");
  end if;
  
  # === SUM OF DIGITS ===
  Put_Line("== Sum of Digits ==");
  Put_Line("Enter a number:");
  Get_Line(n);
  
  result := 0;
  while n > 0 loop
    result := result + (n rem 10);
    n := n / 10;
  end loop;
  
  Put_Line("Sum of digits:");
  Put_Line(result);
  
  # === REVERSE A NUMBER ===
  Put_Line("== Reverse Number ==");
  Put_Line("Enter a number to reverse:");
  Get_Line(n);
  
  result := 0;
  while n > 0 loop
    result := result * 10 + (n rem 10);
    n := n / 10;
  end loop;
  
  Put_Line("Reversed number:");
  Put_Line(result);
  
  # === COUNT PRIMES UP TO N ===
  Put_Line("== Count Primes ==");
  Put_Line("Enter upper limit:");
  Get_Line(n);
  
  count := 0;
  num1 := 2;
  
  while num1 <= n loop
    temp := 0;
    divisor := 2;
    
    while divisor * divisor <= num1 loop
      if num1 rem divisor = 0 then
        temp := temp + 1;
      end if;
      divisor := divisor + 1;
    end loop;
    
    if temp = 0 then
      count := count + 1;
    end if;
    
    num1 := num1 + 1;
  end loop;
  
  Put_Line("Number of primes:");
  Put_Line(count);
  
  # === POWER CALCULATION ===
  Put_Line("== Power ==");
  Put_Line("Enter base:");
  Get_Line(num1);
  Put_Line("Enter exponent:");
  Get_Line(num2);
  
  result := 1;
  i := 0;
  
  while i < num2 loop
    result := result * num1;
    i := i + 1;
  end loop;
  
  Put_Line("Power result:");
  Put_Line(result);
  
  # === COLLATZ CONJECTURE ===
  Put_Line("== Collatz Sequence ==");
  Put_Line("Enter starting number:");
  Get_Line(n);
  
  count := 0;
  Put_Line("Sequence:");
  
  while n /= 1 loop
    Put_Line(n);
    
    if n rem 2 = 0 then
      n := n / 2;
    else
      n := 3 * n + 1;
    end if;
    
    count := count + 1;
  end loop;
  
  Put_Line(n);
  Put_Line("Steps taken:");
  Put_Line(count);
  
  Put_Line("== All tests complete ==");
end Main;
