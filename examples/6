procedure Main is
    x : Integer;
    y : Integer;
    resultado : Integer;
begin
    Get_Line(x);
    Get_Line(y);
    if x > 0 then
        if y > 0 then
            resultado := x + y;
        else
            resultado := x - y;
        end if;
    else
        resultado := 0;
    end if;
    Put_Line(resultado);
end Main;